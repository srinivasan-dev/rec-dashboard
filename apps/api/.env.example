# Copy to .env and adjust as needed. Not required for local dev — PORT defaults to 4000.
PORT=4000

# Powers both AI features: the per-exception "AI Explain" tab (explanationService.ts) and the
# search chat's summaries (searchExplanationService.ts). Optional -- with no key set, the
# per-exception tab uses the mock provider (generatedBy: 'mock') and search summaries use the
# deterministic template (generatedBy: 'fallback'); neither ever errors. Set a real key to switch
# both to live Claude output (generatedBy: 'claude').
CLAUDE_API_KEY=<your-api-key-here>
CLAUDE_MODEL=claude-haiku-4-5-20251001
